// PulsePOS — Excel Tech retail ERP schema
// Postgres via Supabase. One database shared by POS + exceltech.com.bd storefront.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── CONFIGURATION ───────────────────────────────

model Outlet {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  stockLevels    StockLevel[]
  serialUnits    SerialUnit[]
  sales          Sale[]
  purchases      Purchase[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  users          User[]
  requisitions   Requisition[]
  quotations     Quotation[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Color {
  id       String           @id @default(cuid())
  name     String           @unique
  hex      String?
  variants ProductVariant[]
}

model Size {
  id       String           @id @default(cuid())
  name     String           @unique // e.g. 6/128, 8/256, 12/512 — storage for phones, size for others
  variants ProductVariant[]
}

model Unit {
  id       String    @id @default(cuid())
  name     String    @unique // pcs, box, set
  products Product[]
}

model WarrantyPolicy {
  id           String    @id @default(cuid())
  name         String    @unique // "1 Year Official", "6 Month Shop"
  durationDays Int
  description  String?
  products     Product[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  openingDue Decimal @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  payments        SupplierPayment[]
}

// ───────────────────────────── USERS / EMPLOYEES ─────────────────────────────

enum RoleName {
  ADMIN
  MANAGER
  SALESMAN
  ACCOUNTANT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         RoleName @default(SALESMAN)
  outletId     String?
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sales         Sale[]
  purchases     Purchase[]
  journals      JournalEntry[]
  smsCampaigns  SmsCampaign[]
  requisitions  Requisition[]
  quotations    Quotation[]
}

// ──────────────────────────────── PRODUCTS ───────────────────────────────────

enum ProductType {
  SERIALIZED // phones, tablets — tracked per IMEI/serial
  STANDARD   // accessories — tracked by quantity
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique // used by exceltech.com.bd storefront
  type             ProductType @default(STANDARD)
  brandId          String?
  brand            Brand?      @relation(fields: [brandId], references: [id])
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id])
  unitId           String?
  unit             Unit?       @relation(fields: [unitId], references: [id])
  warrantyPolicyId String?
  warrantyPolicy   WarrantyPolicy? @relation(fields: [warrantyPolicyId], references: [id])
  description      String?
  imageUrl         String?
  isPublished      Boolean     @default(false) // visible on storefront
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())

  variants ProductVariant[]
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String  @unique
  barcode       String? @unique
  colorId       String?
  color         Color?  @relation(fields: [colorId], references: [id])
  sizeId        String?
  size          Size?   @relation(fields: [sizeId], references: [id])
  costPrice     Decimal @db.Decimal(12, 2) // costing (what we paid)
  wholesalePrice Decimal? @db.Decimal(12, 2) // price to resellers
  salePrice     Decimal @db.Decimal(12, 2) // retail price charged at POS
  mrp           Decimal? @db.Decimal(12, 2) // printed maximum retail price
  onlinePrice   Decimal? @db.Decimal(12, 2) // storefront price if different
  reorderLevel  Int     @default(2)
  isActive      Boolean @default(true)

  stockLevels     StockLevel[]
  serialUnits     SerialUnit[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  transferItems   StockTransferItem[]
  ledgerEntries   StockLedger[]
  requisitionItems RequisitionItem[]
  quotationItems  QuotationItem[]
  returnItems     SaleReturnItem[]
  exchangeItemsOut ExchangeItem[] @relation("ExchangeOut")
  purchaseReturnItems PurchaseReturnItem[]
}

// ─────────────────────────────── STOCK / SERIALS ─────────────────────────────

model StockLevel {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  outletId  String
  outlet    Outlet         @relation(fields: [outletId], references: [id])
  quantity  Int            @default(0)

  @@unique([variantId, outletId])
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  EXCHANGED
  TRANSFERRED
  DEFECTIVE
  CLAIM_IN_SERVICE
}

model SerialUnit {
  id         String         @id @default(cuid())
  serialNo   String         @unique // IMEI or serial number
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  outletId   String
  outlet     Outlet         @relation(fields: [outletId], references: [id])
  status     SerialStatus   @default(IN_STOCK)
  costPrice  Decimal?       @db.Decimal(12, 2) // per-unit landed cost
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  saleItemId String?
  saleItem   SaleItem?      @relation(fields: [saleItemId], references: [id])
  soldAt     DateTime?
  warrantyUntil DateTime?
  createdAt  DateTime       @default(now())

  warrantyClaims WarrantyClaim[]
}

enum LedgerReason {
  PURCHASE
  SALE
  SALE_RETURN
  EXCHANGE_IN
  EXCHANGE_OUT
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING
}

model StockLedger {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  outletId  String
  reason    LedgerReason
  quantity  Int            // signed: +in, -out
  balance   Int            // stock balance after this entry at outlet
  refType   String?        // Sale / Purchase / Transfer id reference
  refId     String?
  note      String?
  createdAt DateTime       @default(now())

  @@index([variantId, outletId, createdAt])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id           String              @id @default(cuid())
  transferNo   String              @unique
  fromOutletId String
  fromOutlet   Outlet              @relation("TransferFrom", fields: [fromOutletId], references: [id])
  toOutletId   String
  toOutlet     Outlet              @relation("TransferTo", fields: [toOutletId], references: [id])
  status       TransferStatus      @default(PENDING)
  note         String?
  createdAt    DateTime            @default(now())
  receivedAt   DateTime?

  items StockTransferItem[]
}

model StockTransferItem {
  id         String         @id @default(cuid())
  transferId String
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  serialNos  String[]       // for serialized items
}

// ──────────────────────────────── CUSTOMERS / CRM ────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  altPhone     String?
  email        String?
  address      String?
  familyName        String?
  familyPhone       String?
  referenceName     String?
  referencePhone    String?
  referenceRelation String?
  profession        String?
  designation       String?
  organization      String?
  imageUrl          String?
  openingDue   Decimal  @default(0) @db.Decimal(14, 2)
  rewardPoints Int      @default(0)
  rewardLevelId String?
  rewardLevel  RewardLevel? @relation(fields: [rewardLevelId], references: [id])
  note         String?
  createdAt    DateTime @default(now())

  sales         Sale[]
  quotations    Quotation[]
  smsLogs       SmsLog[]
  rewardHistory RewardPointHistory[]
  warrantyClaims WarrantyClaim[]
}

// ──────────────────────────────────── SALES ──────────────────────────────────

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK_TRANSFER
  REWARD_POINTS
}

enum SaleStatus {
  COMPLETED
  PARTIAL_DUE
  FULL_DUE
  RETURNED
  EXCHANGED
}

enum SaleType {
  CUSTOMER
  RETAIL
  WHOLESALE
}

model Sale {
  id          String     @id @default(cuid())
  invoiceNo   String     @unique
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  outletId    String
  outlet      Outlet     @relation(fields: [outletId], references: [id])
  soldById    String?
  soldBy      User?      @relation(fields: [soldById], references: [id])
  saleType    SaleType   @default(CUSTOMER)
  workOrder   String?
  subTotal    Decimal    @db.Decimal(14, 2)
  discount    Decimal    @default(0) @db.Decimal(14, 2)
  additionalExpense Decimal @default(0) @db.Decimal(14, 2)
  vat         Decimal    @default(0) @db.Decimal(14, 2)
  grandTotal  Decimal    @db.Decimal(14, 2)
  paidTotal   Decimal    @default(0) @db.Decimal(14, 2)
  dueTotal    Decimal    @default(0) @db.Decimal(14, 2)
  status      SaleStatus @default(COMPLETED)
  isEmi       Boolean    @default(false)
  note        String?
  createdAt   DateTime   @default(now())

  items       SaleItem[]
  payments    Payment[]
  emiOrder    EmiOrder?
  returns     SaleReturn[]
  exchanges   Exchange[]
  rewardHistory RewardPointHistory[]
}

model SaleItem {
  id         String         @id @default(cuid())
  saleId     String
  sale       Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Decimal        @db.Decimal(12, 2)
  unitCost   Decimal        @db.Decimal(12, 2) // snapshot for profit reports
  lineTotal  Decimal        @db.Decimal(14, 2)

  serialUnits SerialUnit[]
  returnItems SaleReturnItem[]
}

model Payment {
  id         String        @id @default(cuid())
  saleId     String?
  sale       Sale?         @relation(fields: [saleId], references: [id])
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 2)
  reference  String?       // bKash TrxID, card last4
  isDueCollection Boolean  @default(false)
  createdAt  DateTime      @default(now())
}

// ─────────────────────────── RETURNS & EXCHANGE ──────────────────────────────

model SaleReturn {
  id          String   @id @default(cuid())
  returnNo    String   @unique
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  totalAmount Decimal  @db.Decimal(14, 2)
  refundMethod PaymentMethod @default(CASH)
  reason      String?
  createdAt   DateTime @default(now())

  items SaleReturnItem[]
}

model SaleReturnItem {
  id           String         @id @default(cuid())
  returnId     String
  saleReturn   SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId   String
  saleItem     SaleItem       @relation(fields: [saleItemId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  amount       Decimal        @db.Decimal(14, 2)
  serialNos    String[]
  restock      Boolean        @default(true) // false if defective
}

model Exchange {
  id          String   @id @default(cuid())
  exchangeNo  String   @unique
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  diffAmount  Decimal  @db.Decimal(14, 2) // + customer pays, - refund
  reason      String?
  createdAt   DateTime @default(now())

  items ExchangeItem[]
}

model ExchangeItem {
  id           String         @id @default(cuid())
  exchangeId   String
  exchange     Exchange       @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  direction    String         // "IN" (returned by customer) | "OUT" (given to customer)
  variantId    String
  variant      ProductVariant @relation("ExchangeOut", fields: [variantId], references: [id])
  quantity     Int
  unitPrice    Decimal        @db.Decimal(12, 2)
  serialNos    String[]
}

// ─────────────────────────── REQUISITION & QUOTATION ─────────────────────────

enum RequisitionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model Requisition {
  id        String            @id @default(cuid())
  reqNo     String            @unique
  outletId  String
  outlet    Outlet            @relation(fields: [outletId], references: [id])
  createdById String?
  createdBy User?             @relation(fields: [createdById], references: [id])
  status    RequisitionStatus @default(PENDING)
  note      String?
  createdAt DateTime          @default(now())

  items RequisitionItem[]
}

model RequisitionItem {
  id            String         @id @default(cuid())
  requisitionId String
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id         String          @id @default(cuid())
  quoteNo    String          @unique
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id])
  outletId   String
  outlet     Outlet          @relation(fields: [outletId], references: [id])
  createdById String?
  createdBy  User?           @relation(fields: [createdById], references: [id])
  total      Decimal         @db.Decimal(14, 2)
  status     QuotationStatus @default(PENDING)
  validUntil DateTime?
  createdAt  DateTime        @default(now())

  items QuotationItem[]
}

model QuotationItem {
  id          String         @id @default(cuid())
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2)
}

// ─────────────────────────────── PURCHASES ───────────────────────────────────

model Purchase {
  id         String   @id @default(cuid())
  purchaseNo String   @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  createdById String?
  createdBy  User?    @relation(fields: [createdById], references: [id])
  subTotal   Decimal  @db.Decimal(14, 2)
  discount   Decimal  @default(0) @db.Decimal(14, 2)
  additionalExpense Decimal @default(0) @db.Decimal(14, 2)
  grandTotal Decimal  @db.Decimal(14, 2)
  paidTotal  Decimal  @default(0) @db.Decimal(14, 2)
  dueTotal   Decimal  @default(0) @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now())

  items   PurchaseItem[]
  returns PurchaseReturn[]
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  unitCost   Decimal        @db.Decimal(12, 2)
  lineTotal  Decimal        @db.Decimal(14, 2)

  serialUnits SerialUnit[]
  returnItems PurchaseReturnItem[]
}

model PurchaseReturn {
  id         String   @id @default(cuid())
  returnNo   String   @unique
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  total      Decimal  @db.Decimal(14, 2)
  reason     String?
  createdAt  DateTime @default(now())

  items PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  amount         Decimal        @db.Decimal(14, 2)
  serialNos      String[]
}

model SupplierPayment {
  id         String        @id @default(cuid())
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 2)
  reference  String?
  note       String?
  createdAt  DateTime      @default(now())
}

// ─────────────────────────────── ACCOUNTING ──────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique // e.g. 1001
  name      String
  type      AccountType
  parentId  String?
  parent    Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountTree")
  opening   Decimal     @default(0) @db.Decimal(14, 2)
  isSystem  Boolean     @default(false) // auto-posted accounts: Cash, bKash, Sales, COGS…

  lines JournalLine[]
}

model JournalEntry {
  id        String   @id @default(cuid())
  voucherNo String   @unique
  date      DateTime @default(now())
  memo      String?
  refType   String?  // Sale / Purchase / Expense / DueCollection…
  refId     String?
  createdById String?
  createdBy User?    @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)

  @@index([accountId])
}

// ────────────────────────────────── EMI ──────────────────────────────────────

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model EmiOrder {
  id            String   @id @default(cuid())
  saleId        String   @unique
  sale          Sale     @relation(fields: [saleId], references: [id])
  downPayment   Decimal  @db.Decimal(14, 2)
  financed      Decimal  @db.Decimal(14, 2)
  months        Int
  monthlyAmount Decimal  @db.Decimal(14, 2)
  guarantorName String?
  guarantorPhone String?
  nidNumber     String?
  createdAt     DateTime @default(now())

  installments Installment[]
}

model Installment {
  id         String            @id @default(cuid())
  emiOrderId String
  emiOrder   EmiOrder          @relation(fields: [emiOrderId], references: [id], onDelete: Cascade)
  seq        Int               // 1..months
  dueDate    DateTime
  amount     Decimal           @db.Decimal(14, 2)
  paidAmount Decimal           @default(0) @db.Decimal(14, 2)
  paidAt     DateTime?
  method     PaymentMethod?
  status     InstallmentStatus @default(PENDING)

  @@unique([emiOrderId, seq])
}

// ─────────────────────────────── WARRANTY ────────────────────────────────────

enum ClaimStatus {
  RECEIVED
  SENT_TO_SERVICE
  READY
  DELIVERED
  REJECTED
}

model WarrantyClaim {
  id           String      @id @default(cuid())
  claimNo      String      @unique
  serialUnitId String
  serialUnit   SerialUnit  @relation(fields: [serialUnitId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  issue        String
  status       ClaimStatus @default(RECEIVED)
  note         String?
  receivedAt   DateTime    @default(now())
  deliveredAt  DateTime?
}

// ────────────────────────────────── SMS ──────────────────────────────────────

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

model SmsCampaign {
  id        String   @id @default(cuid())
  name      String
  message   String
  audience  String   // ALL | DUE_CUSTOMERS | EMI_PENDING | CUSTOM
  createdById String?
  createdBy User?    @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  logs SmsLog[]
}

model SmsLog {
  id         String     @id @default(cuid())
  campaignId String?
  campaign   SmsCampaign? @relation(fields: [campaignId], references: [id])
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  phone      String
  message    String
  status     SmsStatus  @default(QUEUED)
  cost       Decimal    @default(0) @db.Decimal(8, 4)
  sentAt     DateTime?
  createdAt  DateTime   @default(now())
}

model SmsLedger {
  id        String   @id @default(cuid())
  type      String   // TOPUP | USAGE
  amount    Decimal  @db.Decimal(10, 2)
  balance   Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────── REWARDS ─────────────────────────────────────

model RewardSetup {
  id             String  @id @default(cuid())
  pointsPerTaka  Decimal @default(0.01) @db.Decimal(8, 4) // 1 point per ৳100
  takaPerPoint   Decimal @default(0.5) @db.Decimal(8, 4)  // redemption value
  minRedeemPoints Int    @default(100)
  isActive       Boolean @default(true)
}

model RewardLevel {
  id         String  @id @default(cuid())
  name       String  @unique // Silver, Gold, Platinum
  minPoints  Int
  multiplier Decimal @default(1) @db.Decimal(4, 2)

  customers Customer[]
}

model RewardPointHistory {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id])
  points     Int      // + earned, - redeemed
  reason     String
  createdAt  DateTime @default(now())
}

// ─────────────────────────────── SETTINGS ────────────────────────────────────

model Setting {
  key   String @id
  value String
}

// ─────────────────────────────── ONLINE STORE ────────────────────────────────

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum OnlinePayMethod {
  COD
  BKASH
  NAGAD
}

model OnlineOrder {
  id             String            @id @default(cuid())
  orderNo        String            @unique
  customerName   String
  phone          String
  address        String
  area           String            // INSIDE_DHAKA | OUTSIDE_DHAKA
  note           String?
  payMethod      OnlinePayMethod   @default(COD)
  payReference   String?           // bKash TrxID for prepaid
  status         OnlineOrderStatus @default(PENDING)
  subTotal       Decimal           @db.Decimal(14, 2)
  deliveryCharge Decimal           @db.Decimal(10, 2)
  grandTotal     Decimal           @db.Decimal(14, 2)
  saleId         String?           @unique // filled when confirmed → converted to a Sale
  createdAt      DateTime          @default(now())

  items OnlineOrderItem[]
}

model OnlineOrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  name      String      // snapshot
  variant   String?     // snapshot label
  quantity  Int
  unitPrice Decimal     @db.Decimal(12, 2)
}
