# Supabase Postgres — Project Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) for DATABASE_URL
# and the "Session"/direct connection (port 5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# AI sales/owner agent — Google Gemini (free tier).
# Get a free key at https://aistudio.google.com → "Get API key" (no billing needed).
GEMINI_API_KEY=""
# Optional model overrides (free-tier "-latest" aliases used if unset):
#   GEMINI_CUSTOMER_MODEL  — customer chat (default gemini-flash-lite-latest)
#   GEMINI_OWNER_MODEL     — owner assistant (default gemini-flash-latest)
GEMINI_CUSTOMER_MODEL=""
GEMINI_OWNER_MODEL=""
