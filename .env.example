# Supabase Postgres — Project Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) for DATABASE_URL
# and the "Session"/direct connection (port 5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# AI sales/owner agent — Google Gemini (free tier).
# Get a free key at https://aistudio.google.com → "Get API key" (no billing needed).
GEMINI_API_KEY=""
# Optional model overrides (free-tier "-latest" aliases used if unset):
#   GEMINI_CUSTOMER_MODEL  — customer chat (default gemini-flash-lite-latest)
#   GEMINI_OWNER_MODEL     — owner assistant (default gemini-flash-latest)
GEMINI_CUSTOMER_MODEL=""
GEMINI_OWNER_MODEL=""
# Vision model for reading customer sourcing photos (default gemini-flash-latest)
GEMINI_VISION_MODEL=""
# Daily demand report (auto email). REPORTS_SECRET gates the /api/cron endpoint;
# REPORT_EMAIL is the recipient (defaults to SMTP_USER if unset).
REPORTS_SECRET=""
REPORT_EMAIL=""
# Public storefront base for shareable product links the AI sends customers.
# Defaults to the Netlify shop; set to your domain (e.g. https://exceltech.com.bd) when it serves the store.
STOREFRONT_URL=""

# ── Facebook Messenger + WhatsApp channels (optional; set after Meta app setup) ──
# The same AI agent auto-replies on your FB Page and WhatsApp Business number.
META_VERIFY_TOKEN=""          # any secret string you invent; must match the webhook config in Meta
META_APP_SECRET=""            # Meta app → Settings → Basic → App Secret (verifies webhook payloads)
META_GRAPH_VERSION="v21.0"    # optional Graph API version
MESSENGER_PAGE_TOKEN=""       # Page access token — Messenger replies
WHATSAPP_TOKEN=""             # WhatsApp Cloud API access token (Bearer)
WHATSAPP_PHONE_NUMBER_ID=""   # WhatsApp phone number ID (from Meta → WhatsApp → API Setup)
